# LLM (optional). If OPENAI_API_KEY is empty the chat uses the rule-based Turkish analyzer.
# Any OpenAI-compatible endpoint works; for Groq use the values below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b
# Tried when the primary model errors (rate limit, JSON mode failure, bad code):
OPENAI_MODEL_FALLBACK=openai/gpt-oss-120b

# SMTP (optional). If SMTP_SERVER / SMTP_USER are empty, sending is simulated.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# CORS: all origins are allowed (frontend is static-hosted); no variable needed.
